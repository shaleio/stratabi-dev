# ============================================================================
# StrataBI — local / community edition environment
# ----------------------------------------------------------------------------
# Copy this file to ".env" and fill in the values for YOUR AWS account, then
# run the app with:  python -m stratabi.app   (http://localhost:8050)
#
# ".env" is git-ignored. Never commit real credentials.
# Every value here is read at process start (python-dotenv loads this file).
# ============================================================================

# ----------------------------------------------------------------------------
# 1) AWS CREDENTIALS  (boto3 reads these directly)
# ----------------------------------------------------------------------------
# Pick ONE of the two approaches below.
#
# (a) Named profile from ~/.aws/credentials  (recommended — nothing secret here)
#       run:  aws configure --profile stratabi-dev
AWS_PROFILE=stratabi-dev
AWS_REGION=us-east-1

# (b) OR paste keys directly (comment out AWS_PROFILE above if you use these).
#     Prefer short-lived STS creds; include AWS_SESSION_TOKEN if you have one.
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=...

# ----------------------------------------------------------------------------
# 2) STRATABI DATA PLANE  (these come straight from `terraform output` in infra/)
# ----------------------------------------------------------------------------
STRATABI_MODE=aws
STRATABI_BUCKET=                       # analyst artifact bucket (dashboards, themes, results)
STRATABI_SYSTEM_BUCKET=                # system bucket, if separate from the above
STRATABI_DASHBOARD_PREFIX=analyst/dashboards
STRATABI_MODULE_PREFIX=analyst/modules
STRATABI_THEME_PREFIX=analyst/themes
STRATABI_RESULT_PREFIX=runtime/results

# Athena execution
STRATABI_ATHENA_OUTPUT=                # s3://.../athena-results/
STRATABI_CATALOG_DATABASE=             # Glue/Athena database name
STRATABI_WORKGROUPS=                   # comma-separated workgroups, e.g. wg-0,wg-1
STRATABI_SOURCE_TABLE_PREFIX=

# Async execution Lambdas + status (from terraform output)
STRATABI_ATHENA_ASYNC_LAMBDA_ARN=
STRATABI_STATUS_WRITER_LAMBDA_ARN=
STRATABI_TILE_STATUS_TABLE=
STRATABI_MODULE_REGISTRY_TABLE=
STRATABI_DASHBOARD_GIT_REGISTRY=        # git-registered dashboards (StrataCTL sync)
STRATABI_STATUS_TTL_SECONDS=86400

# ----------------------------------------------------------------------------
# 3) UI / RENDERING DEFAULTS  (optional — sensible auto-defaults if unset)
# ----------------------------------------------------------------------------
STRATABI_THEME=guildmaster
# STRATABI_PLOTLY_TEMPLATE=            # empty = auto (plotly_dark on dark themes)
# STRATABI_AGGRID_THEME=              # empty = auto (ag-theme-alpine-dark on dark)
# STRATABI_DEFAULT_INTERVAL_MS=6000
# STRATABI_DOCS_BASE_URL=https://shaleio.com
